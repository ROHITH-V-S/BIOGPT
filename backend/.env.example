# Which LLM serves answers: 'openrouter' (hosted, capable, 50 requests/day on
# the free tier) or 'ollama' (local, unmetered, much smaller model).
LLM_BACKEND=openrouter

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Models (free-tier, tried in order on failure)
LLM_MODEL_FALLBACK_LIST=["google/gemma-4-31b-it:free","nvidia/nemotron-3-ultra-550b-a55b:free","poolside/laguna-s-2.1:free"]

# Ollama (only used when LLM_BACKEND=ollama). Requires `ollama serve` and
# `ollama pull <model>`. No credential needed — the placeholder is only there
# because the OpenAI SDK insists on a non-empty key.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL_FALLBACK_LIST=["llama3.2:latest","gemma3n:e4b"]

# Embedding Configuration
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_BACKEND=openrouter
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Redis (optional). Caches embeddings + PubMed responses and backs the rate
# limiter. Set REDIS_ENABLED=false to run entirely without it.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Paths
FAISS_INDEX_PATH=data/vector.index
CHUNK_DATA_PATH=data/chunk_data.pkl

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
