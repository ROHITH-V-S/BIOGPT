# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Models (free-tier, tried in order on failure)
LLM_MODEL_FALLBACK_LIST=["google/gemma-4-27b-it:free","nvidia/nemotron-3-ultra-550b-a55b:free","poolside/laguna-s-2.1:free"]

# Embedding Configuration
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_BACKEND=openrouter
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths
FAISS_INDEX_PATH=data/vector.index
CHUNK_DATA_PATH=data/chunk_data.pkl

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
