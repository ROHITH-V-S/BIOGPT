# === LLM backend: 'openrouter' (hosted, 50 req/day free) or 'ollama' (local) ===
LLM_BACKEND=openrouter

# === OpenRouter API ===
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === LLM Models (free-tier, tried in order) ===
LLM_MODEL_FALLBACK_LIST=["google/gemma-4-31b-it:free","nvidia/nemotron-3-ultra-550b-a55b:free","poolside/laguna-s-2.1:free"]

# === Ollama (only used when LLM_BACKEND=ollama) ===
# In Docker, localhost is the container — use host.docker.internal instead.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL_FALLBACK_LIST=["llama3.2:latest","gemma3n:e4b"]

# === Embedding Configuration ===
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_BACKEND=openrouter
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BIOMEDICAL_EMBEDDING_MODEL=pritamdeka/PubMedBERT-mnli-snli-scinli-scitail-mednli-stsb

# === Redis (optional cache + rate-limit store) ===
# The app runs without it: caching is skipped and rate limiting falls back to
# per-process counters. docker-compose overrides the host to the service name.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_EMBEDDINGS=604800
CACHE_TTL_PUBMED=86400

# === Paths ===
FAISS_INDEX_PATH=data/vector.index
CHUNK_DATA_PATH=data/chunk_data.pkl

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# === Entity-aware retrieval ===
ENTITY_AWARE_DEFAULT=false
NER_MODEL=en_core_sci_sm
