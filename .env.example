# === OpenRouter API ===
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === LLM Models (free-tier, tried in order) ===
LLM_MODEL_FALLBACK_LIST=["google/gemma-4-27b-it:free","nvidia/nemotron-3-ultra-550b-a55b:free","poolside/laguna-s-2.1:free"]

# === Embedding Configuration ===
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_BACKEND=openrouter
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BIOMEDICAL_EMBEDDING_MODEL=pritamdeka/PubMedBERT-mnli-snli-scinli-scitail-mednli-stsb

# === Database ===
POSTGRES_PASSWORD=biogpt_dev
DATABASE_URL=postgresql://biogpt:biogpt_dev@postgres:5432/biogpt

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Paths ===
FAISS_INDEX_PATH=data/vector.index
CHUNK_DATA_PATH=data/chunk_data.pkl

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# === Entity-aware retrieval ===
ENTITY_AWARE_DEFAULT=false
NER_MODEL=en_core_sci_sm
